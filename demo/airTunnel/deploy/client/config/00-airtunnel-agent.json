{
  "ReverseTunnelSettings": {
    "Enabled": true,
    "TunnelMode": "Agent",
    "EnableTunnelProxy": false,
    "AgentId": "egress-client-01",
    "ServerAddress": "https://192.168.100.165:8090",
    "AgentConnectionCount": 2,
    "HeartbeatIntervalSeconds": 15,
    "ConfigurationSync": {
      "Enabled": true,
      "IntervalSeconds": 30
    },
    "AgentReconnectInitialDelaySeconds": 5,
    "AgentReconnectMaxDelaySeconds": 60,
    "MaxConcurrentStreams": 512,
    "MaxRequestBodyBytes": 104857600,
    "MaxResponseBodyBytes": 104857600,
    "MaxFramePayloadBytes": 65536,
    "AgentCertificate": {
      "CertificatePath": "/app/data/certs/agent.crt",
      "PrivateKeyPath": "/app/data/certs/agent.key",
      "TrustedIssuerPath": "/app/data/certs/ca.crt",
      "PrivateKeySizeBits": 2048
    },
    "LocalServices": [
      {
        "ServiceName": "Internet Egress",
        "PublicPath": "/internet-egress",
        "Protocol": "https",
        "Host": "example.com",
        "Port": 443
      }
    ],
    "Diagnostics": {
      "Enabled": true,
      "PathPrefix": "/_airtunnel/diagnostics",
      "SnapshotPeriodSeconds": 5
    }
  }
}
