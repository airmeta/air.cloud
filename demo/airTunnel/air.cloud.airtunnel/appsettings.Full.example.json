{
  "Urls": "https://127.0.0.1:18443",
  "Kestrel": {
    "Endpoints": {
      "GatewayHttp": {
        "Url": "http://127.0.0.1:8080",
        "Protocols": "Http1AndHttp2"
      },
      "AirTunnel": {
        "Url": "https://127.0.0.1:18443",
        "Protocols": "Http1AndHttp2",
        "ClientCertificateMode": "AllowCertificate",
        "Certificate": {
          "Path": "X:/air-cloud-reverse-tunnel/server/server.pfx",
          "Password": ""
        }
      },
      "AirTunnelManagement": {
        "Url": "https://127.0.0.1:18643",
        "Protocols": "Http1AndHttp2",
        "ClientCertificateMode": "NoCertificate",
        "Certificate": {
          "Path": "X:/air-cloud-reverse-tunnel/server/server.pfx",
          "Password": ""
        }
      }
    }
  },
  "ReverseTunnelSettings": {
    "Enabled": true,
    "TunnelMode": "Server",
    "EnableTunnelProxy": true,
    "AgentId": "local-full",
    "ServerAddress": "https://127.0.0.1:18443",
    "SessionSelectionStrategy": "RoundRobin",
    "ConfigurationSync": {
      "Enabled": true,
      "IntervalSeconds": 30
    },
    "Gateway": {
      "InvokePathPrefix": "/_airtunnel/gateway"
    },
    "CertificateAuthority": {
      "CertificatePath": "X:/air-cloud-reverse-tunnel/server/ca.pfx",
      "CertificatePasswordEnvironmentVariable": "AIR_TUNNEL_CA_PASSWORD",
      "AgentCertificateLifetimeDays": 30,
      "RenewalWindowDays": 7,
      "RenewalOverlapHours": 24
    },
    "AgentCertificate": {
      "CertificatePath": "X:/air-cloud-reverse-tunnel/agent/local-full/agent.crt",
      "PrivateKeyPath": "X:/air-cloud-reverse-tunnel/agent/local-full/agent.key",
      "TrustedIssuerPath": "X:/air-cloud-reverse-tunnel/agent/local-full/ca.crt",
      "PrivateKeySizeBits": 2048
    },
    "LocalServices": [
      {
        "ServiceName": "本地 HTTP 服务",
        "PublicPath": "/local",
        "Protocol": "http",
        "Host": "127.0.0.1",
        "Port": 5100
      }
    ],
    "Diagnostics": {
      "Enabled": true,
      "PathPrefix": "/_airtunnel/diagnostics",
      "SnapshotPeriodSeconds": 5
    },
    "Management": {
      "Enabled": true,
      "BindUrl": "https://127.0.0.1:18643",
      "PathPrefix": "/_airtunnel/admin",
      "AccessTokenEnvironmentVariable": "AIR_TUNNEL_ADMIN_TOKEN",
      "ConfigDirectory": "configs",
      "BackupDirectory": "config-backups",
      "AllowConfigWrite": true,
      "AllowRemoteClientManagement": true,
      "AllowAnonymousLoopback": true
    }
  }
}
