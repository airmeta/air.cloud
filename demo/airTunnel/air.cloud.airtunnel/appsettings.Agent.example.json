{
  "Urls": "http://127.0.0.1:18543",
  "ReverseTunnelSettings": {
    "Enabled": true,
    "TunnelMode": "Agent",
    "EnableTunnelProxy": false,
    "AgentId": "local-dev",
    "ServerAddress": "https://192.168.80.101:18443",
    "AgentConnectionCount": 4,
    "HeartbeatIntervalSeconds": 15,
    "ConfigurationSync": {
      "Enabled": true,
      "IntervalSeconds": 30
    },
    "AgentCertificate": {
      "CertificatePath": "X:/air-cloud-reverse-tunnel/agent/local-dev/agent.crt",
      "PrivateKeyPath": "X:/air-cloud-reverse-tunnel/agent/local-dev/agent.key",
      "TrustedIssuerPath": "X:/air-cloud-reverse-tunnel/agent/local-dev/ca.crt",
      "PrivateKeySizeBits": 2048
    },
    "LocalServices": [
      {
        "ServiceName": "账户服务",
        "PublicPath": "/account",
        "Protocol": "http",
        "Host": "127.0.0.1",
        "Port": 5108
      },
      {
        "ServiceName": "系统服务",
        "PublicPath": "/system",
        "Protocol": "http",
        "Host": "127.0.0.1",
        "Port": 5107
      }
    ],
    "Tcp": {
      "Enabled": true,
      "LocalServices": [
        {
          "ServiceName": "TCP Echo",
          "Host": "127.0.0.1",
          "Port": 19201,
          "ServerListenHost": "0.0.0.0",
          "ServerListenPort": 19101
        }
      ]
    },
    "Udp": {
      "Enabled": true,
      "LocalServices": [
        {
          "ServiceName": "UDP Echo",
          "Host": "127.0.0.1",
          "Port": 19202,
          "ServerListenHost": "0.0.0.0",
          "ServerListenPort": 19102
        }
      ]
    },
    "Diagnostics": {
      "Enabled": false,
      "PathPrefix": "/_airtunnel/diagnostics",
      "SnapshotPeriodSeconds": 5
    }
  }
}
