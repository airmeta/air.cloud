{
  "GatewaySettings": {
    "OcelotConfigurationSource": "File"
  },
  "ConsulServiceOptions": {
    "ConsulAddress": "",
    "ServiceAddress": "http://127.0.0.1:5100",
    "ConfigurationServiceName": "air.gateway",
    "RegistryServiceName": "air.gateway"
  },
  "AllowCors": "http://localhost:5173,http://127.0.0.1:5173",
  "AppLogFilter": {
    "MinimumLevel": "Information",
    "MinimumLevelOverrides": {
      "Ocelot": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
      "Microsoft.AspNetCore.ResponseCaching.ResponseCachingMiddleware": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "SkyMirrorShieldSettings": {
    "EnableSkyMirrorShield": false,
    "WhiteHeader": "Launcher",
    "RouteValidateWhiteList": "/Health,/v1/pub/init,/v1/pub/captcha,/v1/identity/login",
    "RequestLog": {
      "Enabled": true,
      "LogAllowedRequests": false,
      "LogRejectedRequests": true,
      "SampleRate": 0
    }
  },
  "TraceLogSettings": {
    "Enabled": false,
    "SinkType": "LocalFile",
    "DeliveryMode": "Durable",
    "EnableLocalLog": true,
    "LocalLogDirectory": "logs",
    "QueueCapacity": 65536,
    "BatchSize": 500,
    "FlushIntervalSeconds": 2,
    "StopDrainTimeoutSeconds": 30,
    "SinkFailureRetryIntervalMilliseconds": 1000,
    "EnableDurableSpool": true,
    "SpoolDirectory": "logs/trace-spool",
    "SpoolSegmentMaxBytes": 16777216,
    "SpoolMaxFilesPerCycle": 256,
    "CaptureRequestBody": true,
    "CaptureResponseBody": true,
    "MaxRequestBodyBytes": 4096,
    "MaxResponseBodyBytes": 4096,
    "FallbackToLocalFile": true,
    "CaptureContentTypes": [
      "application/json",
      "text/",
      "application/xml",
      "application/x-www-form-urlencoded"
    ]
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/v1/identity/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 5108
        }
      ],
      "UpstreamPathTemplate": "/v1/identity/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH"
      ]
    },
    {
      "DownstreamPathTemplate": "/v1/security/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "127.0.0.1",
          "Port": 5107
        }
      ],
      "UpstreamPathTemplate": "/v1/security/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH"
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://127.0.0.1:5100"
  },
  "Environment": "Production"
}
