<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Air.Cloud.Modules.ReverseTunnel</PackageId>
    <Title>Air.Cloud.Modules.ReverseTunnel</Title>
    <Authors>AC</Authors>
    <Company>AccessCross</Company>
    <Product>air.cloud</Product>
    <Description>Air.Cloud.Modules.ReverseTunnel 提供 AirTunnel HTTP 内网穿透模块，包含服务端接入、代理会话、Ocelot 隧道转发、流量中继、运行时限制、指标采集和诊断 API。</Description>
    <PackageDescription>Air.Cloud.Modules.ReverseTunnel 提供 AirTunnel HTTP 内网穿透模块，包含服务端接入、代理会话、Ocelot 隧道转发、流量中继、运行时限制、指标采集和诊断 API。</PackageDescription>
    <PackageTags>Air.Cloud;AirTunnel;ReverseTunnel;NetworkTunnel;Gateway;Ocelot;HTTP;Module</PackageTags>
    <PackageProjectUrl>https://github.com/AccessCross/air.cloud</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AccessCross/air.cloud</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>..\..\..\builds\nuget</PackageOutputPath>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackAsTool>False</PackAsTool>
    <Version>10.26.9.1</Version>
    <PackageVersion>10.26.9.1</PackageVersion>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.26.9.1</FileVersion>
    <InformationalVersion>10.26.09.01</InformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\assets\logo.png" Link="logo.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Include="..\..\..\LICENSE" Link="LICENSE">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Include="..\..\..\README.md" Link="README.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.70.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Grpc.Tools" Version="2.70.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Ocelot" Version="17.0.1" />
    <ProjectReference Include="..\..\core\Air.Cloud.Core\Air.Cloud.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\reverse_tunnel.proto" GrpcServices="Both" Access="Internal" />
    <EmbeddedResource Include="Management\management.html" />
  </ItemGroup>

</Project>
