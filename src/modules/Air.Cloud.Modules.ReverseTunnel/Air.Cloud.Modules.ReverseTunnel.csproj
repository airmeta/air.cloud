<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Air.Cloud.Modules.ReverseTunnel</PackageId>
    <Title>Air.Cloud.Modules.ReverseTunnel</Title>
    <Description>Air.Cloud reverse tunnel module for controlled cross-network HTTP forwarding.</Description>
    <PackageTags>Air.Cloud;ReverseTunnel;Gateway;HTTP;Module</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.70.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Grpc.Tools" Version="2.70.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0-preview.6.25358.103" />
    <PackageReference Include="Ocelot" Version="17.0.1" />
    <ProjectReference Include="..\..\core\Air.Cloud.Core\Air.Cloud.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\reverse_tunnel.proto" GrpcServices="Both" Access="Internal" />
  </ItemGroup>

</Project>
