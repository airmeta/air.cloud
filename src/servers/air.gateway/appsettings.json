{
  //Consul����
  "ConsulServiceOptions": {
    "ConsulAddress": "http://192.168.100.156:8500/",
    "ServiceName": "air.gateway"
  },
  "GatewaySettings": {
    // Ocelot 配置来源：Consul、File、ConsulThenFile。未配置时默认 Consul。
    "OcelotConfigurationSource": "Consul"
  },
  "AllowCors": "http://localhost:5174,http://192.168.110.130:5174,http://localhost:5173,http://localhost:8080",
  "AppLogFilter": {
    "MinimumLevel": "Information",
    "MinimumLevelOverrides": {
      "Ocelot": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
      "Microsoft.AspNetCore.ResponseCaching.ResponseCachingMiddleware": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "SkyMirrorShieldSettings": {
    //是否启用天镜盾
    "EnableSkyMirrorShield": false,
    //白名单请求头 配置此配置项的请求头不会被拦截
    "WhiteHeader": "Launcher",
    //白名单路由 配置此配置项的路由不会被拦截
    "RouteValidateWhiteList": "",
    "SkyMirrorShieldHeaderValid": {
      //查询应用详情地址
      "AppQueryUrl": "http://127.0.0.1:5107/v1/security/app/detail/{AppId}",
      //查询应用所有路由地址
      "RouteQueryUrl": "http://127.0.0.1:5107/v1/security/approute/query/all-auth/{AppId}",
      "TicketValidUrl": "http://127.0.0.1:5106/v1/auth/valid/Ticket/{Ticket}/{ClientId}"
    },
    "RequestLog": {
      "Enabled": true,
      "LogAllowedRequests": false,
      "LogRejectedRequests": true,
      "SampleRate": 0
    }
  },
  "JWTSettings": {
    "ValidateIssuerSigningKey": true,
    "ValidateIssuer": true,
    "ValidIssuer": "san shi soft",
    "ValidateAudience": true,
    "ValidAudience": "client",
    "ValidateLifetime": true,
    "IsRefreshAccessToken": false,
    "ExpiredTime": 120,
    "ClockSkew": 5,
    "AccessTokenStore": 720,
    "RefreshTokenStore": 840,
    "IssuerSigningKey": "san shi soft"
  },
  "TaxinSettings": {
    "PersistenceMethod": 2
  },
  "RedisSettings": {
    "ConnectionString": "192.168.100.156:6379,allowadmin=true"
  },
  "DataBaseSettings": {
    "Options": [
      {
        "Key": "air_cloud",
        "ConnectionString": "http://192.168.100.31:9200/",
        "Account": "",
        "Password": ""
      }
    ]
  },
  //日志记录配置
  "TraceLogSettings": {
    "Enabled": true,
    "SinkType": "ElasticSearch",
    "DeliveryMode": "Durable",
    //过滤掉的记录
    "Filters": [
      "depositimport",
      "snc_micro_api",
      "hffcj_auth_api/route"
    ],
    //是否启用本地记录
    "EnableLocalLog": false,
    //本地记录目录
    "LocalLogDirectory": "logs",
    "QueueCapacity": 65536,
    "BatchSize": 500,
    "FlushIntervalSeconds": 2,
    "StopDrainTimeoutSeconds": 30,
    "SinkFailureRetryIntervalMilliseconds": 1000,
    "EnableDurableSpool": true,
    "SpoolDirectory": "logs/trace-spool",
    "SpoolSegmentMaxBytes": 16777216,
    "SpoolMaxFilesPerCycle": 256,
    "CaptureRequestBody": true,
    "CaptureResponseBody": true,
    "MaxRequestBodyBytes": 4096,
    "MaxResponseBodyBytes": 4096,
    "FallbackToLocalFile": true,
    "CaptureContentTypes": [
      "application/json",
      "text/",
      "application/xml",
      "application/x-www-form-urlencoded"
    ]
  },
  "Environment": "Development"
}
